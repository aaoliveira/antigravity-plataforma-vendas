# Seller Intelligence Platform — Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# DO NOT commit real credentials or production secrets to this file.

# -----------------------------------------------------------------------------
# Database (PostgreSQL 18.x)
# -----------------------------------------------------------------------------
POSTGRES_DB=seller_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Cache (Redis 7/8)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# -----------------------------------------------------------------------------
# Messaging (RabbitMQ 4.x)
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# -----------------------------------------------------------------------------
# Identity Provider (Keycloak 26.x - OIDC)
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_PORT=8085
KEYCLOAK_ISSUER_URI=http://localhost:8085/realms/seller-intelligence

# -----------------------------------------------------------------------------
# Backend (Spring Boot 3.5.x)
# -----------------------------------------------------------------------------
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend (Next.js 15.x)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8082
PORT=3000
