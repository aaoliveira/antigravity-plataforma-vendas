{
  "manifest_version": 3,
  "name": "Seller Intelligence Platform — Assistente Contextual",
  "version": "1.0.0",
  "description": "Interface complementar e segura para vendedores de e-commerce e marketplaces (Mercado Livre e Shopee).",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Seller Intelligence Platform"
  },
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mercadolivre.com.br/*",
        "*://*.shopee.com.br/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
