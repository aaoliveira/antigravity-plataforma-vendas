# Git ignore for Seller Intelligence Platform Monorepo

# Environment & Secrets (Mandatory Anti-Hallucination & Security Rule)
.env
.env.local
.env.*.local
*.pem
*.key
*.p12

# Operating System
.DS_Store
Thumbs.db

# IDE & Editors
.idea/
*.iml
.vscode/
*.swp
*.swo

# Backend (Java / Maven)
backend/target/
build/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# Frontend & Extension (Node / Next.js / Vite)
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/.pnpm-store/
extension/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs & Runtime
logs/
*.log

# Docker Volumes
docker_volumes/
