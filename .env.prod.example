# =============================================================================
# Seller Intelligence Platform — Template de Variáveis para Produção (.env.prod)
# ATENÇÃO: NUNCA COMMITE ESTE ARQUIVO COM SEGREDO REAL NO GIT
# Preencha este arquivo no servidor seguro de produção e proteja com chmod 600
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Banco de Dados Transacional (PostgreSQL 17+ com RLS)
# -----------------------------------------------------------------------------
POSTGRES_DB=seller_intelligence
POSTGRES_USER=seller_prod_user
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI_MINIMO_32_CHARS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Se utilizar banco gerenciado (ex: AWS RDS / GCP Cloud SQL), configure:
# SPRING_DATASOURCE_URL=jdbc:postgresql://seu-rds-host:5432/seller_intelligence?sslmode=require
# SPRING_DATASOURCE_USERNAME=seu_usuario
# SPRING_DATASOURCE_PASSWORD=sua_senha_segura

# -----------------------------------------------------------------------------
# 2. Cache e Rate Limiter (Redis 7+)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=GERE_UMA_SENHA_FORTE_REDIS_AQUI

# -----------------------------------------------------------------------------
# 3. Message Broker (RabbitMQ 3.13 / 4.x)
# -----------------------------------------------------------------------------
RABBITMQ_USER=seller_rabbit
RABBITMQ_PASSWORD=GERE_UMA_SENHA_FORTE_RABBIT_AQUI
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# -----------------------------------------------------------------------------
# 4. Segurança e Criptografia Mandatória (OWASP ASVS / Defesa em Profundidade)
# -----------------------------------------------------------------------------
# Segredo para assinatura de Tokens JWT (Chave de no mínimo 256 bits em Hexadecimal ou Base64)
JWT_SECRET=GERE_UM_SEGREDO_HEX_64_CHARS_PARA_ASSINATURA_DE_TOKENS_JWT_AQUI
JWT_EXPIRATION_SECONDS=900

# Chave mestra AES-256-GCM para criptografia em repouso de tokens OAuth dos marketplaces (64 chars hex)
TOKEN_ENCRYPTION_KEY=GERE_CHAVE_HEX_64_CHARS_AES256_PARA_CIFRAGEM_EM_REPOUSO_AQUI

# -----------------------------------------------------------------------------
# 5. Integrações Oficiais de Marketplace (Mercado Livre & Shopee)
# -----------------------------------------------------------------------------
# Mercado Livre (App Homologado no DevCenter ML)
MELI_APP_ID=SEU_APP_ID_OFICIAL_MERCADO_LIVRE
MELI_CLIENT_SECRET=SEU_CLIENT_SECRET_MERCADO_LIVRE
MELI_REDIRECT_URI=https://seu-dominio.com.br/api/v1/integrations/mercadolivre/callback

# Shopee Open Platform v2 (App Homologado no Shopee Open Platform)
SHOPEE_PARTNER_ID=SEU_PARTNER_ID_NUMERICO
SHOPEE_PARTNER_KEY=SUA_PARTNER_KEY_SHOPEE
SHOPEE_REDIRECT_URL=https://seu-dominio.com.br/api/v1/integrations/shopee/callback
SHOPEE_SANDBOX=false
SHOPEE_ENABLED=true

# -----------------------------------------------------------------------------
# 6. Gateway de IA Multi-Provider (Secrets Manager)
# -----------------------------------------------------------------------------
AI_GATEWAY_API_KEY=SUA_CHAVE_API_DO_PROVEDOR_DE_IA
AI_PROVIDER=GOOGLE
AI_MODEL_NAME=gemini-1.5-flash

# -----------------------------------------------------------------------------
# 7. Domínios e URLs Públicas da Aplicação
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://seu-dominio.com.br
CORS_ALLOWED_ORIGINS=https://seu-dominio.com.br
